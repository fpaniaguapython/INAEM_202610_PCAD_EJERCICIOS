      "source": [
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "data = [1.7, 1.8, 1.72, 1.65, 1.61, 2.15, 1.81, 1.70]\n",
        "\n",
        "serie = pd.Series(data)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "## Boxplot"
      ],
      "metadata": {
        "id": "3AKJxO5k8m07"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "plt.boxplot(serie, vert=False)\n",
        "plt.title(\"Boxplot\")\n",
        "plt.xlabel(\"Altura (m)\")\n",
        "plt.show()"
      ],
